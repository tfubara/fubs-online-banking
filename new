/*
  VAULTLY: demo banking app in ONE file (back end + front end).
  Needs Node.js 22.5 or newer. No npm install.
  Run:   node --no-warnings vaultly.js      then open http://localhost:3000
*/
const http = require('node:http');
const path = require('node:path');
const fs = require('node:fs');
const crypto = require('node:crypto');
const { DatabaseSync } = require('node:sqlite');

/* ================= DATABASE ================= */

fs.mkdirSync(path.join(__dirname, 'data'), { recursive: true });
const db = new DatabaseSync(path.join(__dirname, 'data', 'bank.db'));
db.exec('PRAGMA journal_mode = WAL; PRAGMA foreign_keys = ON;');
db.exec(`
CREATE TABLE IF NOT EXISTS users (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  nin_hash      TEXT NOT NULL UNIQUE,   -- HMAC of the NIN, never the raw NIN
  nin_last4     TEXT NOT NULL,
  phone         TEXT NOT NULL UNIQUE,
  email         TEXT NOT NULL UNIQUE,
  password_hash TEXT NOT NULL,
  first_name    TEXT NOT NULL,
  middle_name   TEXT NOT NULL DEFAULT '',
  last_name     TEXT NOT NULL,
  dob           TEXT NOT NULL,          -- from NIN; age is always computed from this
  gender        TEXT NOT NULL DEFAULT '',
  address       TEXT NOT NULL,
  created_at    TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE TABLE IF NOT EXISTS accounts (
  user_id        INTEGER PRIMARY KEY REFERENCES users(id),
  account_number TEXT NOT NULL UNIQUE,
  balance        INTEGER NOT NULL DEFAULT 0 CHECK (balance >= 0),   -- kobo
  savings        INTEGER NOT NULL DEFAULT 0 CHECK (savings >= 0)    -- kobo
);
CREATE TABLE IF NOT EXISTS transactions (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id       INTEGER NOT NULL REFERENCES users(id),
  type          TEXT NOT NULL,          -- topup | transfer | save | bill
  direction     TEXT NOT NULL,          -- credit | debit
  amount        INTEGER NOT NULL,       -- kobo
  balance_after INTEGER NOT NULL,
  counterparty  TEXT NOT NULL DEFAULT '',
  description   TEXT NOT NULL DEFAULT '',
  reference     TEXT NOT NULL,
  created_at    TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE INDEX IF NOT EXISTS idx_tx_user ON transactions(user_id, id DESC);
`);

function tx(fn) {            // run fn atomically
  db.exec('BEGIN IMMEDIATE');
  try { const r = fn(); db.exec('COMMIT'); return r; }
  catch (e) { db.exec('ROLLBACK'); throw e; }
}

/* ================= NIN LOOKUP ================= */

const PROVIDER = process.env.NIN_PROVIDER || 'mock';

// FAKE test people, used only when NIN_PROVIDER=mock.
const MOCK_NIN_DATA = {
  '12345678901': {"firstName": "Amina", "middleName": "Zainab", "lastName": "Bello", "dob": "1995-03-14", "gender": "F", "phone": "08012345678", "address": "12 Allen Avenue, Ikeja, Lagos"},
  '10987654321': {"firstName": "Chinedu", "middleName": "", "lastName": "Okafor", "dob": "1988-11-02", "gender": "M", "phone": "08098765432", "address": "45 Aba Road, Port Harcourt, Rivers"},
  '11122233344': {"firstName": "Tunde", "middleName": "Ayodele", "lastName": "Adeyemi", "dob": "2001-07-21", "gender": "M", "phone": "07011122233", "address": "7 Ring Road, Ibadan, Oyo"},
  '55566677788': {"firstName": "Test", "middleName": "", "lastName": "Minor", "dob": "2012-05-05", "gender": "F", "phone": "09055566677", "address": "1 Test Street, Abuja"},
};

async function lookupMock(nin) {
  const r = MOCK_NIN_DATA[nin];
  return r ? { nin, ...r } : null;
}

// Real provider (NIN_PROVIDER=http): set NIN_API_URL and NIN_API_KEY, then adapt
// mapHttpResponse() to your provider's documented response (Dojah, Prembly, Smile ID, Youverify...).
function mapHttpResponse(nin, body) {
  const d = body.entity || body.data || body;
  if (!d || !(d.first_name || d.firstName)) return null;
  return {
    nin,
    firstName: d.first_name || d.firstName,
    middleName: d.middle_name || d.middleName || '',
    lastName: d.last_name || d.lastName || d.surname,
    dob: normaliseDob(d.date_of_birth || d.birthdate || d.dob),
    gender: String(d.gender || '').charAt(0).toUpperCase(),
    phone: d.phone_number || d.phone || d.telephoneno || '',
    address: [d.residence_address || d.address, d.residence_lga, d.residence_state].filter(Boolean).join(', ')
  };
}

function normaliseDob(v) {
  if (!v) return null;
  const s = String(v);
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
  const m = s.match(/^(\d{2})-(\d{2})-(\d{4})$/); // DD-MM-YYYY
  return m ? `${m[3]}-${m[2]}-${m[1]}` : null;
}

async function lookupHttp(nin) {
  const url = process.env.NIN_API_URL, key = process.env.NIN_API_KEY;
  if (!url || !key) throw new Error('NIN provider not configured');
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${key}` },
    body: JSON.stringify({ nin })
  });
  if (res.status === 404) return null;
  if (!res.ok) throw new Error(`NIN provider error ${res.status}`);
  return mapHttpResponse(nin, await res.json());
}

async function lookupNin(nin) {
  return PROVIDER === 'http' ? lookupHttp(nin) : lookupMock(nin);
}


/* ================= BACK END ================= */
const PORT = process.env.PORT || 3000;
const SECRET = process.env.JWT_SECRET || crypto.randomBytes(32).toString('hex');
if (!process.env.JWT_SECRET) console.warn('! JWT_SECRET not set: using a random one (logins reset on restart).');
const NIN_PEPPER = process.env.NIN_PEPPER || SECRET;
const DEMO_TOPUP = process.env.DEMO_TOPUP !== 'false';   // fake "Add Money"; replace with a payment gateway
const REQUIRE_PHONE_MATCH = process.env.REQUIRE_PHONE_MATCH !== 'false';
const MAX_TX_NAIRA = 5_000_000;

/* ---------- helpers ---------- */
class HttpError extends Error { constructor(status, msg) { super(msg); this.status = status; } }
const b64 = (b) => Buffer.from(b).toString('base64url');
const hmac = (s, k = SECRET) => crypto.createHmac('sha256', k).update(s).digest('base64url');

function signToken(uid) {
  const body = b64(JSON.stringify({ uid, exp: Date.now() + 7 * 864e5 }));
  return `${body}.${hmac(body)}`;
}
function verifyToken(t) {
  const [body, sig] = String(t || '').split('.');
  if (!body || !sig) return null;
  const good = hmac(body);
  if (sig.length !== good.length || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(good))) return null;
  const p = JSON.parse(Buffer.from(body, 'base64url').toString());
  return p.exp > Date.now() ? p.uid : null;
}
function hashPassword(pw) {
  const salt = crypto.randomBytes(16);
  return `${salt.toString('hex')}:${crypto.scryptSync(pw, salt, 64).toString('hex')}`;
}
function checkPassword(pw, stored) {
  const [salt, hash] = stored.split(':');
  const h = crypto.scryptSync(pw, Buffer.from(salt, 'hex'), 64);
  return crypto.timingSafeEqual(h, Buffer.from(hash, 'hex'));
}
const ninHash = (nin) => hmac(nin, NIN_PEPPER);
const ref = () => 'TX' + Date.now().toString(36).toUpperCase() + crypto.randomBytes(3).toString('hex').toUpperCase();

function normPhone(p) {
  let s = String(p || '').replace(/[\s-]/g, '');
  if (s.startsWith('+234')) s = '0' + s.slice(4);
  else if (s.startsWith('234') && s.length === 13) s = '0' + s.slice(3);
  return /^0[789][01]\d{8}$/.test(s) ? s : null;
}
function ageFrom(dob) {
  const d = new Date(dob), n = new Date();
  let a = n.getFullYear() - d.getFullYear();
  if (n < new Date(n.getFullYear(), d.getMonth(), d.getDate())) a--;
  return a;
}
function toKobo(v) {
  const n = Number(v);
  if (!Number.isFinite(n) || n <= 0) throw new HttpError(400, 'Enter a valid amount');
  if (n > MAX_TX_NAIRA) throw new HttpError(400, `Maximum per transaction is ₦${MAX_TX_NAIRA.toLocaleString()}`);
  return Math.round(n * 100);
}
function profile(uid) {
  const u = db.prepare(`SELECT u.*, a.account_number, a.balance, a.savings FROM users u JOIN accounts a ON a.user_id=u.id WHERE u.id=?`).get(uid);
  if (!u) return null;
  return {
    id: u.id,
    fullName: [u.first_name, u.middle_name, u.last_name].filter(Boolean).join(' '),
    firstName: u.first_name, dob: u.dob, age: ageFrom(u.dob), gender: u.gender,
    address: u.address, phone: u.phone, email: u.email, ninLast4: u.nin_last4,
    accountNumber: u.account_number, balance: u.balance, savings: u.savings
  };
}
function newAccountNumber() {
  for (;;) {
    const n = '30' + String(crypto.randomInt(0, 1e8)).padStart(8, '0');
    if (!db.prepare('SELECT 1 FROM accounts WHERE account_number=?').get(n)) return n;
  }
}

/* in-memory rate limiter: max `n` hits per `ms` per key */
const hits = new Map();
function limit(key, n, ms) {
  const now = Date.now(), arr = (hits.get(key) || []).filter((t) => now - t < ms);
  arr.push(now); hits.set(key, arr);
  if (arr.length > n) throw new HttpError(429, 'Too many attempts. Please wait and try again.');
}
setInterval(() => { const now = Date.now(); for (const [k, v] of hits) if (!v.some((t) => now - t < 36e5)) hits.delete(k); }, 6e5).unref();

/* ---------- route handlers ---------- */
const routes = {};
const route = (method, p, auth, fn) => (routes[`${method} ${p}`] = { auth, fn });

route('POST', '/api/auth/register', false, async ({ body, ip }) => {
  limit('reg:' + ip, 10, 36e5);
  const nin = String(body.nin || '').trim();
  const phone = normPhone(body.phone);
  const email = String(body.email || '').trim().toLowerCase();
  const password = String(body.password || '');
  if (!/^\d{11}$/.test(nin)) throw new HttpError(400, 'NIN must be 11 digits');
  if (!phone) throw new HttpError(400, 'Enter a valid Nigerian phone number');
  if (!/^[a-z0-9._%+-]+@gmail\.com$/.test(email)) throw new HttpError(400, 'Enter a valid Gmail address (name@gmail.com)');
  if (password.length < 8) throw new HttpError(400, 'Password must be at least 8 characters');

  const h = ninHash(nin);
  if (db.prepare('SELECT 1 FROM users WHERE nin_hash=? OR phone=? OR email=?').get(h, phone, email))
    throw new HttpError(409, 'An account already exists with this NIN, phone number or email');

  // Everything else (name, age, address, gender) comes from the NIN record, not from the user.
  let rec;
  try { rec = await lookupNin(nin); } catch (e) { console.error(e); throw new HttpError(502, 'NIN verification is unavailable right now. Try again shortly.'); }
  if (!rec) throw new HttpError(422, 'We could not find this NIN. Check the number and try again.');
  if (REQUIRE_PHONE_MATCH && normPhone(rec.phone) !== phone)
    throw new HttpError(422, 'This phone number does not match the one linked to your NIN.');
  if (!rec.dob || ageFrom(rec.dob) < 18) throw new HttpError(403, 'You must be at least 18 years old to open an account.');

  const uid = tx(() => {
    const r = db.prepare(`INSERT INTO users (nin_hash,nin_last4,phone,email,password_hash,first_name,middle_name,last_name,dob,gender,address)
      VALUES (?,?,?,?,?,?,?,?,?,?,?)`).run(h, nin.slice(-4), phone, email, hashPassword(password),
      rec.firstName, rec.middleName || '', rec.lastName, rec.dob, rec.gender || '', rec.address || '');
    db.prepare('INSERT INTO accounts (user_id, account_number) VALUES (?,?)').run(r.lastInsertRowid, newAccountNumber());
    return Number(r.lastInsertRowid);
  });
  return { status: 201, data: { token: signToken(uid), user: profile(uid) } };
});

route('POST', '/api/auth/login', false, async ({ body, ip }) => {
  limit('login:' + ip, 15, 15 * 6e4);
  const id = String(body.identifier || '').trim().toLowerCase();
  const u = db.prepare('SELECT * FROM users WHERE email=? OR phone=?').get(id, normPhone(id) || '__none__');
  if (!u || !checkPassword(String(body.password || ''), u.password_hash)) throw new HttpError(401, 'Incorrect login details');
  return { data: { token: signToken(u.id), user: profile(u.id) } };
});

route('GET', '/api/me', true, ({ uid }) => ({ data: profile(uid) }));

route('GET', '/api/transactions', true, ({ uid, query }) => {
  const lim = Math.min(Number(query.get('limit')) || 50, 200);
  return { data: db.prepare('SELECT id,type,direction,amount,balance_after,counterparty,description,reference,created_at FROM transactions WHERE user_id=? ORDER BY id DESC LIMIT ?').all(uid, lim) };
});

route('GET', '/api/lookup', true, ({ query }) => {
  const acct = String(query.get('account') || '');
  if (!/^\d{10}$/.test(acct)) throw new HttpError(400, 'Account number must be 10 digits');
  const r = db.prepare('SELECT u.first_name, u.last_name FROM accounts a JOIN users u ON u.id=a.user_id WHERE a.account_number=?').get(acct);
  if (!r) throw new HttpError(404, 'Account not found');
  return { data: { name: `${r.first_name} ${r.last_name}`, accountNumber: acct } };
});

route('POST', '/api/topup', true, ({ uid, body }) => {
  if (!DEMO_TOPUP) throw new HttpError(501, 'Funding requires a payment gateway integration');
  const amt = toKobo(body.amount);
  tx(() => {
    db.prepare('UPDATE accounts SET balance=balance+? WHERE user_id=?').run(amt, uid);
    const bal = db.prepare('SELECT balance FROM accounts WHERE user_id=?').get(uid).balance;
    db.prepare(`INSERT INTO transactions (user_id,type,direction,amount,balance_after,counterparty,description,reference) VALUES (?,?,?,?,?,?,?,?)`)
      .run(uid, 'topup', 'credit', amt, bal, 'Wallet funding', 'Add money (demo)', ref());
  });
  return { data: profile(uid) };
});

route('POST', '/api/transfer', true, ({ uid, body }) => {
  limit('xfer:' + uid, 30, 6e4);
  const amt = toKobo(body.amount);
  const to = String(body.accountNumber || '');
  const note = String(body.note || '').slice(0, 100);
  tx(() => {
    const me = db.prepare('SELECT * FROM accounts WHERE user_id=?').get(uid);
    const dest = db.prepare('SELECT a.*, u.first_name, u.last_name FROM accounts a JOIN users u ON u.id=a.user_id WHERE a.account_number=?').get(to);
    if (!dest) throw new HttpError(404, 'Recipient account not found');
    if (dest.user_id === uid) throw new HttpError(400, 'You cannot transfer to yourself');
    if (me.balance < amt) throw new HttpError(400, 'Insufficient balance');
    const sender = db.prepare('SELECT first_name,last_name FROM users WHERE id=?').get(uid);
    const r = ref();
    db.prepare('UPDATE accounts SET balance=balance-? WHERE user_id=?').run(amt, uid);
    db.prepare('UPDATE accounts SET balance=balance+? WHERE user_id=?').run(amt, dest.user_id);
    const insert = db.prepare(`INSERT INTO transactions (user_id,type,direction,amount,balance_after,counterparty,description,reference) VALUES (?,?,?,?,?,?,?,?)`);
    insert.run(uid, 'transfer', 'debit', amt, me.balance - amt, `${dest.first_name} ${dest.last_name}`, note || 'Transfer', r);
    insert.run(dest.user_id, 'transfer', 'credit', amt, dest.balance + amt, `${sender.first_name} ${sender.last_name}`, note || 'Transfer', r);
  });
  return { data: profile(uid) };
});

route('POST', '/api/save', true, ({ uid, body }) => {
  const amt = toKobo(body.amount);
  const out = body.direction === 'out';
  tx(() => {
    const a = db.prepare('SELECT * FROM accounts WHERE user_id=?').get(uid);
    if (out ? a.savings < amt : a.balance < amt) throw new HttpError(400, out ? 'Not enough in savings' : 'Insufficient balance');
    const bal = a.balance + (out ? amt : -amt);
    db.prepare('UPDATE accounts SET balance=?, savings=savings+? WHERE user_id=?').run(bal, out ? -amt : amt, uid);
    db.prepare(`INSERT INTO transactions (user_id,type,direction,amount,balance_after,counterparty,description,reference) VALUES (?,?,?,?,?,?,?,?)`)
      .run(uid, 'save', out ? 'credit' : 'debit', amt, bal, 'Savings', out ? 'Withdrawn from savings' : 'Moved to savings', ref());
  });
  return { data: profile(uid) };
});

const BILLS = { airtime: 'Airtime', data: 'Data', tv: 'TV', electricity: 'Electricity' };
route('POST', '/api/bills', true, ({ uid, body }) => {
  limit('bill:' + uid, 30, 6e4);
  const cat = String(body.category || '');
  if (!BILLS[cat]) throw new HttpError(400, 'Unknown bill category');
  const provider = String(body.provider || '').slice(0, 40);
  const target = String(body.target || '').replace(/[^\w-]/g, '').slice(0, 20);
  if (!provider || !target) throw new HttpError(400, 'Provider and number are required');
  const amt = toKobo(body.amount);
  // NOTE: demo only. Real bill payment needs an aggregator API (VTpass, Flutterwave Bills, etc.).
  tx(() => {
    const a = db.prepare('SELECT balance FROM accounts WHERE user_id=?').get(uid);
    if (a.balance < amt) throw new HttpError(400, 'Insufficient balance');
    db.prepare('UPDATE accounts SET balance=balance-? WHERE user_id=?').run(amt, uid);
    db.prepare(`INSERT INTO transactions (user_id,type,direction,amount,balance_after,counterparty,description,reference) VALUES (?,?,?,?,?,?,?,?)`)
      .run(uid, 'bill', 'debit', amt, a.balance - amt, provider, `${BILLS[cat]} - ${target}`, ref());
  });
  return { data: profile(uid) };
});


