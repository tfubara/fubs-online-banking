:root{--bg:#07111f;--panel:#101d30;--panel2:#172740;--text:#f4f7ff;--muted:#9aabc4;--blue:#3185ff;--border:#293b55;--notice:#172e49;--danger:#ff8181}body.light{--bg:#f2f6fc;--panel:#fff;--panel2:#edf3fb;--text:#14243c;--muted:#64748b;--blue:#1264dc;--border:#d5dfed;--notice:#e8f2ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif;line-height:1.55}header{display:flex;justify-content:space-between;align-items:center;padding:20px 5%;border-bottom:1px solid var(--border)}.brand{font-weight:900;color:var(--text);text-decoration:none}.brand span,.eyebrow{color:var(--blue)}.shell{width:min(980px,calc(100% - 32px));margin:32px auto}.panel{background:var(--panel);border:1px solid var(--border);border-radius:18px;padding:25px;margin-bottom:20px}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.15em}h1{font-size:clamp(27px,4vw,38px);margin:8px 0}h2{font-size:22px}.muted{color:var(--muted)}label{display:block;margin:14px 0 7px;font-size:14px;font-weight:650}input,select{width:100%;padding:12px;background:var(--panel2);border:1px solid var(--border);border-radius:9px;color:var(--text);font:inherit}button{font:inherit;font-weight:700;border:0;border-radius:9px;padding:12px 16px;cursor:pointer}.primary{background:var(--blue);color:white}.secondary{background:var(--panel2);color:var(--text);border:1px solid var(--border)}.full{width:100%;margin-top:20px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.hidden{display:none!important}.formgrid,.twocol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px}.twocol{gap:20px}.stephead{margin:20px 0}.progress{height:7px;background:var(--panel2);border-radius:8px;overflow:hidden;margin-top:8px}.progress div{height:100%;width:25%;background:var(--blue);transition:width .2s}.split{justify-content:space-between;border-top:1px solid var(--border);padding-top:18px}.notice,.summary{background:var(--notice);border:1px solid var(--border);padding:13px;border-radius:10px;font-size:13px}.camera{min-height:220px;background:#030914;border:1px dashed var(--border);border-radius:14px;display:grid;place-items:center;text-align:center;padding:12px;color:#c3d1e7;overflow:hidden}.camera video,.camera img{width:100%;max-height:340px;object-fit:contain}.check{display:flex;gap:10px;align-items:flex-start}.check input{width:auto;margin-top:5px}.status{display:flex;justify-content:space-between;gap:15px;padding:12px 0;border-bottom:1px solid var(--border)}.status span,.small{color:var(--muted);font-size:13px}.detail{padding:10px 0;border-bottom:1px solid var(--border);overflow-wrap:anywhere}.detail span{display:block;color:var(--muted);font-size:13px}.message{white-space:pre-line;margin-top:14px}.error{color:var(--danger)}footer{text-align:center;padding:25px;color:var(--muted);font-size:13px}@media(max-width:650px){header{padding:16px}.panel{padding:18px}.formgrid,.twocol{grid-template-columns:1fr}.shell{margin:20px auto}}
