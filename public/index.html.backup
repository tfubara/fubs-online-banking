<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fubs Online Banking</title><link rel="stylesheet" href="/styles.css"><script src="/app.js" defer></script></head>
<body><header><a class="brand" href="/">FUBS <span>ONLINE BANKING</span></a><button id="theme" class="secondary">Switch theme</button></header><main class="shell">
<section id="auth" class="panel"><div class="eyebrow">SECURE ACCOUNT ACCESS</div><h1 id="heading">Welcome to Fubs</h1><p class="muted">Development foundation. Registration does not activate real banking services.</p><div class="actions"><button id="login-tab" class="primary">Sign in</button><button id="register-tab" class="secondary">Create account</button></div>
<form id="login-form"><label>Email address</label><input id="login-email" type="email" autocomplete="username" required maxlength="254"><label>Password</label><input id="login-password" type="password" autocomplete="current-password" required maxlength="128"><button class="primary full">Sign in</button></form>
<form id="register-form" class="hidden"><div class="stephead"><strong id="step-label">Step 1 of 4</strong><div class="progress"><div id="progress-fill"></div></div></div>
<section class="reg-step" data-step="1"><h2>1. Personal information</h2><p class="muted">NIN and BVN are not requested.</p><div class="formgrid"><div><label>First name</label><input id="firstName" required maxlength="80"></div><div><label>Middle name (optional)</label><input id="middleName" maxlength="80"></div><div><label>Last name</label><input id="lastName" required maxlength="80"></div><div><label>Date of birth</label><input id="dob" type="date" required></div><div><label>Gender (optional)</label><select id="gender"><option value="">Prefer not to say</option><option>Female</option><option>Male</option><option>Another identity</option></select></div><div><label>Country</label><input id="country" value="Nigeria" required maxlength="80"></div><div><label>State / region</label><input id="stateRegion" required maxlength="100"></div><div><label>City</label><input id="city" required maxlength="100"></div></div><label>Residential address</label><input id="address" required maxlength="250"><label>Postal code (optional)</label><input id="postal" maxlength="20"></section>
<section class="reg-step hidden" data-step="2"><h2>2. Contact and profile</h2><p class="muted">Email and phone verification must be connected to real providers before they can be marked verified.</p><label>Email address</label><input id="email" type="email" required maxlength="254"><label>Phone number</label><input id="phone" type="tel" required maxlength="25"><label>Occupation (optional)</label><input id="occupation" maxlength="100"><label>Employment status</label><select id="employment"><option value="">Choose an option</option><option>Employed</option><option>Self-employed</option><option>Student</option><option>Unemployed</option><option>Retired</option><option>Other</option></select></section>
<section class="reg-step hidden" data-step="3"><h2>3. Account security</h2><label>Password (12+ characters)</label><input id="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password"><label>Confirm password</label><input id="confirmPassword" type="password" required minlength="12" maxlength="128" autocomplete="new-password"><label>6-digit transaction PIN</label><input id="pin" type="password" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="off"><label>Confirm transaction PIN</label><input id="confirmPin" type="password" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="off"><p class="notice">Use a unique password and PIN. This starter does not enable money transfers.</p></section>
<section class="reg-step hidden" data-step="4"><h2>4. Selfie and confirmation</h2><p class="muted">A selfie capture is not face recognition. This starter does not upload or store the selfie.</p><div class="camera"><video id="video" autoplay playsinline muted class="hidden"></video><img id="preview" class="hidden" alt="Selfie preview"><div id="camera-placeholder">Allow camera access to show a preview.</div></div><div class="actions"><button id="open-camera" class="secondary" type="button">Open camera</button><button id="capture" class="primary" type="button" disabled>Capture selfie</button><button id="retake" class="secondary hidden" type="button">Retake</button></div><p id="camera-status" class="muted small" aria-live="polite"></p><label class="check"><input id="terms" type="checkbox" required> I accept the terms and understand this is not an active bank account.</label><div id="summary" class="summary"></div></section>
<div class="actions split"><button id="back" type="button" class="secondary hidden">Back</button><button id="next" type="button" class="primary">Continue</button><button id="submit" type="submit" class="primary hidden">Submit registration</button></div></form><div id="message" class="message" role="status"></div></section>
<section id="dashboard" class="hidden"><div class="panel"><div class="eyebrow">ACCOUNT OVERVIEW</div><h1>Hello, <span id="dash-name"></span></h1><div class="status"><span>Account status</span><strong id="account-status"></strong></div><div class="status"><span>Face verification</span><strong id="face-status"></strong></div><div class="status"><span>Account number</span><strong id="account-number"></strong></div><p class="notice">No real balance is shown: this app is not connected to a bank or payment processor.</p><button id="logout" class="secondary">Sign out</button></div><div class="twocol"><section class="panel"><h2>Profile</h2><div id="profile"></div></section><section class="panel"><h2>Transactions</h2><p class="muted">Real-money transactions are disabled. Only actual records from the ledger will be shown.</p><div id="transactions"></div></section></div></section></main><footer>Fubs Online Banking · Development foundation</footer></body></html>
